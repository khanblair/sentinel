{
  "name": "@sentinel/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server/index.js",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "rm -f prisma/test.db && DATABASE_URL=\"file:./prisma/test.db\" prisma migrate deploy && DATABASE_URL=\"file:./prisma/test.db\" vitest run",
    "test:e2e": "playwright install --with-deps chromium && vitest run -c vitest.e2e.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.5",
    "@ai-sdk/google": "^1.0.10",
    "@ai-sdk/openai": "^1.0.11",
    "@fastify/cors": "^9.0.1",
    "@prisma/client": "^5.20.0",
    "@sentinel/shared": "workspace:*",
    "ai": "^4.0.18",
    "cron-parser": "^4.9.0",
    "fastify": "^4.28.1",
    "playwright": "^1.48.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
