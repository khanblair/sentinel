# Dependencies
node_modules/
.pnpm-store/

# Env / secrets
.env
.env.*
!.env.example

# Build output
dist/
out/
release/
build/
*.tsbuildinfo
apps/desktop/backend-deploy/

# Prisma / SQLite
apps/backend/prisma/*.db
apps/backend/prisma/*.db-journal
*.db
*.db-journal

# Local secrets (provider API key encryption key) — apps/backend/.keys/ is where it
